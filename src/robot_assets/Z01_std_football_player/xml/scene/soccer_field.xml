<!-- 足球场场景段（worldbody）：由 t4_std_parallel.xml 的 <worldbody>
     内 <include> 引入。仅包含 <worldbody> 段，无 <mujoco> 根标签；
     纹理/材质在 soccer_field_assets.xml 中声明。

     命名约定（与 sim_t4_std_parallel 的 C++ 接口对应）：
       - soccer_ball / ball_free_joint / ball_geom / ball_preview：足球与
         预览点，SetSoccerMode/SetBallPosition/SetBallVelocity/BallPreview
         回调按名查找。
       - goal_left_post / goal_right_post / goal_crossbar / goal_net：
         对方球门（RoboCup 成人组右端 x=+7.02），CollectBodyGeoms 按名
         收集，随足球模式显示/隐藏；target_destination 发布其门口位置。
       - goal_self_*：本方球门（x=-7.02），同样加入可见性集合。

     尺寸来源 robocup_field.xml（gen_robocup_field.py 生成，勿手改数值）：
       成人组场地 14m x 9m，球门宽 2.6m、高 1.2m，中圈半径 1.8m。 -->
<worldbody>
  <!-- ============ 草地（纯视觉，抬高 0.5mm 避免与全局地面 z-fight；
       碰撞始终由 t4_std_parallel.xml 的无限地面提供） ============ -->
  <geom name="field_ground" type="plane" pos="0 0 0.0005" size="11 7.5 0.5"
        material="field_mat" condim="1" friction="1.0 0.005 0.0001"
        />

  <!-- ============ 场地白线（纯视觉，不碰撞） ============ -->
  <geom name="line_goal_self" type="box" pos="-7.0000 0.0000 0.002" size="0.0250 4.5000 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="line_goal_oppo" type="box" pos="7.0000 0.0000 0.002" size="0.0250 4.5000 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="line_touch_left" type="box" pos="0.0000 4.5000 0.002" size="7.0000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="line_touch_right" type="box" pos="0.0000 -4.5000 0.002" size="7.0000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="line_middle" type="box" pos="0.0000 0.0000 0.002" size="0.0250 4.5000 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="center_circle" type="mesh" mesh="circle_ring_mesh" pos="0 0 0.002" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="pen_self_front" type="box" pos="-4.0000 0.0000 0.002" size="0.0250 3.0000 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="pen_self_top" type="box" pos="-5.5000 3.0000 0.002" size="1.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="pen_self_bottom" type="box" pos="-5.5000 -3.0000 0.002" size="1.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="pen_oppo_front" type="box" pos="4.0000 0.0000 0.002" size="0.0250 3.0000 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="pen_oppo_top" type="box" pos="5.5000 3.0000 0.002" size="1.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="pen_oppo_bottom" type="box" pos="5.5000 -3.0000 0.002" size="1.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="goal_area_self_front" type="box" pos="-6.0000 0.0000 0.002" size="0.0250 2.0000 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="goal_area_self_top" type="box" pos="-6.5000 2.0000 0.002" size="0.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="goal_area_self_bottom" type="box" pos="-6.5000 -2.0000 0.002" size="0.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="goal_area_oppo_front" type="box" pos="6.0000 0.0000 0.002" size="0.0250 2.0000 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="goal_area_oppo_top" type="box" pos="6.5000 2.0000 0.002" size="0.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="goal_area_oppo_bottom" type="box" pos="6.5000 -2.0000 0.002" size="0.5000 0.0250 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="penalty_spot_self" type="cylinder" pos="-4.9000 0 0.002" size="0.06 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>
  <geom name="penalty_spot_oppo" type="cylinder" pos="4.9000 0 0.002" size="0.06 0.001" material="line_mat" contype="0" conaffinity="0" group="2"/>

  <!-- ============ 对方球门（x=+7.02，C++ 按名收集，进 target_destination） ============ -->
  <body name="goal_oppo_group" pos="7.0200 0 0" euler="0 0 3.1416">
    <body name="goal_left_post" pos="0 1.30 0">
      <geom type="capsule" fromto="0 0 0  0 0 1.20" size="0.025" material="goal_post_mat"/>
    </body>
    <body name="goal_right_post" pos="0 -1.30 0">
      <geom type="capsule" fromto="0 0 0  0 0 1.20" size="0.025" material="goal_post_mat"/>
    </body>
    <body name="goal_crossbar" pos="0 0 1.20">
      <geom type="capsule" fromto="0 -1.30 0  0 1.30 0" size="0.025" material="goal_post_mat"/>
    </body>
    <body name="goal_net" pos="-0.225 0 0.60">
      <geom name="goal_net_back" type="box" pos="-0.225 0 0" size="0.02 1.30 0.60" rgba="0.95 0.95 0.95 0.3" condim="3"/>
      <geom name="goal_net_top" type="box" pos="0 0 0.60" size="0.22 1.30 0.01" rgba="0.95 0.95 0.95 0.3" />
      <geom name="goal_net_l" type="box" pos="0 -1.30 0" size="0.22 0.01 0.60" rgba="0.95 0.95 0.95 0.3" />
      <geom name="goal_net_r" type="box" pos="0 1.30 0" size="0.22 0.01 0.60" rgba="0.95 0.95 0.95 0.3" />
    </body>
  </body>

  <!-- ============ 本方球门（x=-7.02，仅场地完整性） ============
       网盒在门线后方（local x 取负，与 robocup_field.xml 的 goal_self 一致）：
       背板 world x=-7.47，顶/侧板 -7.465..-7.025，开口朝向场地。 -->
  <body name="goal_self_post_l" pos="-7.0200 1.30 0">
    <geom type="capsule" fromto="0 0 0  0 0 1.20" size="0.025" material="goal_post_mat"/>
  </body>
  <body name="goal_self_post_r" pos="-7.0200 -1.30 0">
    <geom type="capsule" fromto="0 0 0  0 0 1.20" size="0.025" material="goal_post_mat"/>
  </body>
  <body name="goal_self_crossbar" pos="-7.0200 0 1.20">
    <geom type="capsule" fromto="0 -1.30 0  0 1.30 0" size="0.025" material="goal_post_mat"/>
  </body>
  <body name="goal_self_net" pos="-7.0200 0 0.60">
    <geom type="box" pos="-0.45 0 0" size="0.02 1.30 0.60" rgba="0.95 0.95 0.95 0.3" condim="3"/>
    <geom type="box" pos="-0.225 0 0.60" size="0.22 1.30 0.01" rgba="0.95 0.95 0.95 0.3" />
    <geom type="box" pos="-0.225 -1.30 0" size="0.22 0.01 0.60" rgba="0.95 0.95 0.95 0.3" />
    <geom type="box" pos="-0.225 1.30 0" size="0.22 0.01 0.60" rgba="0.95 0.95 0.95 0.3" />
  </body>

  <!-- ============ 球（物理碰撞，初始隐藏于 -100，足球模式开启后归位） ============
       接触参数与 robocup_field.xml 完全一致（已验证的球感）：
       - condim=6 启用滚动摩擦，纯滚动才会减速停止（condim=4 时球滚动
         无阻力，轻碰就滚个不停）；
       - solref="0.02 1" 临界阻尼接触，落地不弹跳；
       - priority=1 让球的摩擦/求解参数覆盖接触对面的地面默认值。 -->
  <body name="soccer_ball" pos="0.4 0 -100">
    <freejoint name="ball_free_joint"/>
    <geom name="ball_geom" type="sphere" size="0.11" mass="0.4" material="ball_material" condim="6" friction="0.8 0.005 0.004" solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2" priority="1"/>
  </body>

  <!-- ============ 足球放置预览点（mocap body，放置模式下显示目标位置） ============ -->
  <body name="ball_preview" mocap="true" pos="0 0 -100">
    <geom name="ball_preview_geom" type="sphere" size="0.05" rgba="1.0 0.85 0.0 0.8" contype="0" conaffinity="0"/>
  </body>
</worldbody>
