<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>robot_audio</name>
  <version>0.0.1</version>
  <description>离线文本转语音播报模块</description>
  <maintainer email="developer@company.com">Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>python3-yaml</depend>

  <exec_depend>ament_python</exec_depend>
  <member_of_group>ament_python</member_of_group>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
