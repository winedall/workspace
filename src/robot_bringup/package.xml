<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>Launch and bringup package for the robot control system.</description>
  <maintainer email="maintainer@example.com">TODO</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  
  <exec_depend>domain_bridge</exec_depend>
  <exec_depend>robot_api</exec_depend>
  <exec_depend>robot_router</exec_depend>
  <exec_depend>robot_battery</exec_depend>
  <exec_depend>robot_recorder</exec_depend>
  <exec_depend>robot_control</exec_depend>
  <exec_depend>robot_driver</exec_depend>
  <exec_depend>robot_rl_manager</exec_depend>
  <exec_depend>robot_odometry</exec_depend>
  <exec_depend>robot_state</exec_depend>
  <exec_depend>robot_teleop</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>yesense_std_ros2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
